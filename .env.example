# Jarvis environment variables (copy to .env and fill as needed).
# All keys are optional; defaults are defined in config.yaml.
# This file contains NO secrets.

# Ollama / LLM
# JARVIS_OLLAMA_HOST=http://localhost:11434
# JARVIS_LLM_MODEL=qwen2.5:0.5b
# JARVIS_NUM_CTX=2048
# JARVIS_NUM_PREDICT=512
# JARVIS_TEMPERATURE=0.3
# JARVIS_TIMEOUT=90

# Speech-to-text
# JARVIS_STT_SAMPLE_RATE=16000
# JARVIS_STT_MODEL_PATH=

# Text-to-speech
# JARVIS_TTS_PREFER_ONLINE=true
# JARVIS_TTS_VOICE=vi-VN-NamMinhNeural

# RAG
# JARVIS_RAG_MODEL=all-MiniLM-L6-v2
# JARVIS_RAG_CHUNK_SIZE=512
# JARVIS_RAG_OVERLAP=80
# JARVIS_RAG_TOP_K=4

# Vision
# JARVIS_VISION_MODEL=moondream:latest

# Resource limits
# JARVIS_RESOURCE_MAX_WORKERS=2
# JARVIS_RESOURCE_MAX_RAM_GB=12
