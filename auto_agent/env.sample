# Copy this file to .env on each machine and fill in provider keys locally.
# Never commit .env or paste provider credentials into logs/prompts.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
GITHUB_TOKEN=

# Optional model routing overrides. Four-agent mode needs four distinct routes.
SWARM_AGENT_MODELS=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_PREFER_LOCAL=false
OLLAMA_NUM_PARALLEL=1
DEFAULT_AGENT_COUNT=4
AGENT_TIMEOUT=300
